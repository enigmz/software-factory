{
  "repo": "C:/repos/project",
  "database": "data/factory/state.sqlite3",
  "worktrees": "data/factory/worktrees",
  "artifacts": "data/factory/artifacts",
  "models": {
    "default": "YOUR_OPENAI_MODEL",
    "ui": "YOUR_VISION_AND_FUNCTION_CALLING_MODEL"
  },
  "checks": {
    "tests": ["python", "-m", "pytest", "-q"],
    "lint": ["python", "-m", "ruff", "check", "."],
    "acceptance": ["python", "-m", "pytest", "tests/acceptance", "-q"]
  },
  "auto_merge": false,
  "auto_paths": [],
  "isolation": {
    "mode": "docker",
    "image": "software-factory-worker:local",
    "memory_mb": 1536,
    "cpus": 2,
    "timeout_seconds": 180
  },
  "preview": {
    "directory": "dist",
    "startup_timeout": 10.0
  },
  "browser": {
    "base_url": "http://127.0.0.1:8765",
    "headless": true,
    "max_actions": 40,
    "timeout_ms": 10000,
    "max_seconds": 300
  }
}
